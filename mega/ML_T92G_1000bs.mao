[ MEGAinfo ]
ver                                   = 10.2.6
DataType                              = Nucleotide
[ DataSettings ]
datatype                              = snNucleotide
containsCodingNuc                     = False
MissingBaseSymbol                     = ?
IdenticalBaseSymbol                   = .
GapSymbol                             = -
[ ProcessTypes ]
ppInfer                               = true
ppML                                  = true
[ AnalysisSettings ]
Analysis                              = Phylogeny Reconstruction
Statistical Method                    = Maximum Likelihood
Phylogeny Test                        = ====================
Test of Phylogeny                     = Bootstrap method
No. of Bootstrap Replications         = 1000
Substitution Model                    = ====================
Substitutions Type                    = Nucleotide
Model/Method                          = Tamura 3-parameter model
Rates and Patterns                    = ====================
Rates among Sites                     = Gamma Distributed (G)
No of Discrete Gamma Categories       = 5
Data Subset to Use                    = ====================
Gaps/Missing Data Treatment           = Use all sites
Site Coverage Cutoff (%)              = Not Applicable
Tree Inference Options                = ====================
ML Heuristic Method                   = Nearest-Neighbor-Interchange (NNI)
Initial Tree for ML                   = Make initial tree automatically (Default - NJ/BioNJ)
Branch Swap Filter                    = None
System Resource Usage                 = ====================
Number of Threads                     = 4


